
import {
    Button,
    CheckBox,
    LineEdit
} from "std-widgets.slint";

export component MainWindow inherits Window {
    
    title: "playing around with Slint";
    width: 800px;
    height: 400px;
    
    // ill just try and guess how it works
    property <int> count: 0;

    Rectangle {
        width: parent.width / 2;
        height: parent.height / 2;
        background: grey;

        Text {
            text: count;
            font-size: 34px;
            color: #000000;
        }

        TouchArea {
            clicked => {
                count += 1;
            }
        }
    }
}
