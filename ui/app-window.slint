import { Theme } from "theme.slint";
import { TaskPanel } from "components/task-panel.slint";
import { TaskAttributes } from "components/task-attributes.slint";
import { TaskForm, Api } from "types.slint";
import { WeekView } from "components/week-view.slint";

export { TaskForm }

import { TaskBlock } from "components/task-block.slint";
export { Api }


export component MainWindow inherits Window {
    title: "Aevum";
    background: Theme.background;

    width: self.preferred-width;
    height: 800px;
    
    callback task-placed(int, int, int);
    callback task-resized(int, int, int);
    callback task-to-panel(int, int, length);
    callback save-task(TaskForm);
    in-out property <[TaskForm]> scheduled-tasks;

    in-out property <string> status-message: "";
    in-out property <bool> is-error: false;
    in-out property <int> max-title;
    in-out property <int> max-description;
    in-out property <int> max-duration;

    in-out property <[TaskForm]> left-column-tasks;
    in-out property <[TaskForm]> right-column-tasks;

    in-out property <length> active-drag-offset-x: 0px;
    in-out property <length> active-drag-offset-y: 0px;

    out property <length> hour-height: Theme.hour-height;
    out property <length> task-block-min-height: Theme.task-block-min-height;
    out property <length> task-block-width: Theme.task-block-width;
    out property <length> panel-gap: Theme.spacing-medium;

    // had to do color on this one to make my rust code work
    // since im not using a gradient in the near future, it doesn't matter for now
    out property <color> default-task-color: Theme.surface-raised;

    keyboard-scope := FocusScope {
        // ---- escape to exit ----
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close();
                accept
            } else {
                reject
            }
        }

        HorizontalLayout {
            spacing: 0px;
            
            VerticalLayout {
                width: Theme.task-block-width * 2 + Theme.spacing-medium * 3; // TODO make a variable
                spacing: 0px;

                TaskPanel {
                    left-column <=> root.left-column-tasks;
                    right-column <=> root.right-column-tasks;

                    drag-offset-changed(ox, oy) => {
                        root.active-drag-offset-x = ox;
                        root.active-drag-offset-y = oy;
                    }
                    dropped-here(id, col, y) => {
                        root.task-to-panel(id, col, y);
                    }
                }

                TaskAttributes {
                    save-task(form) => { root.save-task(form); }
                    status-message <=> root.status-message;
                    is-error <=> root.is-error;
                    max-title <=> root.max-title;
                    max-description <=> root.max-description;
                    max-duration <=> root.max-duration;
                }
            }

            WeekView {
                scheduled-tasks <=> root.scheduled-tasks;
                active-drag-offset-x <=> root.active-drag-offset-x;
                active-drag-offset-y <=> root.active-drag-offset-y;

                task-placed(id, c, m) => {
                    root.task-placed(id, c, m);
                }
                task-resized(id, s, d) => {
                    root.task-resized(id, s, d);
                }
            }
        }
    }
}
