import { Button } from "std-widgets.slint";

export component AppWindow inherits Window {
    
    // this closes the app when escape key is pressed
    forward-focus: keyboard;
    keyboard := FocusScope {
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close();
                accept
            } else {
                reject
            }
        }
    }

    width: 200px;
    height: 200px;

    callback pressed(bool);
    VerticalLayout {
        Rectangle {
            background: navy;
            Text {
                text: "hi im a button";
                font-size: 20px;
            }
            TouchArea {
                clicked => {
                    root.pressed(false);
                }
                double-clicked => {
                    root.pressed(true);
                }
            }
        }
        Button {
            text: "im am better";
            clicked => {
                debug("debug msg becuz i got clicked");
            }
        }
    }
}
