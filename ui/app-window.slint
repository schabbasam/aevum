import { Theme } from "style.slint";
import { TaskPanel } from "components/task-panel.slint";
import { TaskAttributes } from "components/task-attributes.slint";

export component MainWindow inherits Window {
    title: "Aevum";
    background: Theme.background;

    width: 1200px;
    height: 800px;
   
   keyboard-scope := FocusScope {
        // ---- escape to exit ----
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close();
                accept
            } else {
                reject
            }
        }

        HorizontalLayout {
            spacing: 0px;
            
            VerticalLayout {
                width: Theme.panel-width;
                spacing: 0px;

                TaskPanel {
                    vertical-stretch: 1;
                }

                TaskAttributes {
                }
            }

            Rectangle {
                background: Theme.background;
                horizontal-stretch: 1;
            }
        }
    }
}
