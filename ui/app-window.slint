import { Theme } from "style.slint";
import { TaskPanel } from "components/task-panel.slint";
import { TaskAttributes } from "components/task-attributes.slint";

export component MainWindow inherits Window {
    title: "Aevum";
    background: Theme.background;

    preferred-width: 1200px;
    preferred-height: 800px;

    HorizontalLayout {
        spacing: 0px;
        
        VerticalLayout {
            width: Theme.panel-width;
            spacing: 0px;

            TaskPanel {
                vertical-stretch: 1;
            }

            TaskAttributes {
            }
        }

        Rectangle {
            background: Theme.background;
            horizontal-stretch: 1;
        }
    }
}
