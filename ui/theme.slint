
// this is my very own theme that makes everything look consistent
export global Theme {
    // ---- surfaces ----
    out property <brush> background:        #fafbfc;
    out property <brush> surface:           #f1f4f8;
    out property <brush> surface-raised:    #ffffff;

    // ---- text ----
    out property <brush> foreground:        #202938;
    out property <brush> foreground-muted:  #718096;
    out property <brush> on-accent:         #ffffff; // text color on accent

    // ---- accents ----
    out property <brush> accent:            #5865d9;
    out property <brush> accent-hover:      #4854c4;
    out property <brush> accent-pressed:    #3945a8;
    out property <brush> accent-disabled:   #b9c0ed;

    // ---- controls ----
    out property <brush> control-bg:        #ffffff;
    out property <brush> control-hover:     #e9edf3; // the hover shoulnt be too different
    out property <brush> control-pressed:   #dce2eb;
    out property <brush> control-disabled:  #edf0f4;

    // ---- lines ----
    out property <brush> border:            #dce2ea;
    out property <brush> border-focus:      #5865d9;
    out property <brush> border-disabled:   #edf0f4;

    // ---- feedback ----
    out property <brush> danger:            #e05260;
    out property <brush> success:           #239b79;

    // ---- shapes & metrics ----
    out property <length> radius-small:     2px;
    out property <length> radius-medium:    4px;
    out property <length> spacing-small:    4px;
    out property <length> spacing-medium:   8px;
    out property <length> spacing-large:    12px;
    out property <length> control-height:   32px;

    out property <length> border-width:     1px;
    out property <length> focus-ring-width: 2px;

    // ---- typography ----
    out property <length> font-size-small:   12px;
    out property <length> font-size-medium:  14px;
    out property <int> font-weight-normal:   400;
    out property <int> font-weight-bold:     700;

    // ---- motion ----
    out property <duration> anim-fast:      120ms;
    out property <duration> anim-medium:    200ms;
}


