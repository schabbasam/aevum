
// this is my very own theme that makes everything look consistent
export global Theme {
    // ---- surfaces ----
    out property <brush> background:        #ffffff;
    out property <brush> surface:           #f5f5f5;
    out property <brush> surface-raised:    #ffffff;

    // ---- text ----
    out property <brush> foreground:        #1a1a1a;
    out property <brush> foreground-muted:  #6b6b6b;
    out property <brush> on-accent:         #b3245f; // this is just random

    // ---- accents ----
    out property <brush> accent:            #2563eb;
    out property <brush> accent-hover:      #1d4ed8;
    out property <brush> accent-pressed:    #1e40af;
    out property <brush> accent-disabled:   #93c5fd;

    // ---- controls ----
    out property <brush> control-bg:        #ffffff;
    out property <brush> control-hover:     #c0c0c0;
    out property <brush> control-pressed:   #a0a0a0;
    out property <brush> control-disabled:  #e5e5e5;

    // ---- lines ----
    out property <brush> border:            #d4d4d4;
    out property <brush> border-focus:      #2563eb;
    out property <brush> border-disabled:   #e5e5e5;

    // ---- feedback ----
    out property <brush> danger:            #dc2626;
    out property <brush> success:           #16a34a;

    // ---- shapes & metrics ----
    out property <length> radius-small:     4px;
    out property <length> radius-medium:    8px;
    out property <length> spacing-small:    4px;
    out property <length> spacing-medium:   8px;
    out property <length> spacing-large:    12px;
    out property <length> control-height:   32px;

    // ---- typography ----
    out property <length> font-size-small:   12px;
    out property <length> font-size-medium:  14px;
    out property <int> font-weight-normal:   400;
    out property <int> font-weight-bold:     600;

    // ---- motion ----
    out property <duration> anim-fast:      100ms;
    out property <duration> anim-medium:    150ms;
}


