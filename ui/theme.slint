
// this is my very own theme that makes everything look consistent
export global Theme {
    // ---- surfaces ----
    out property <brush> background:        #111024;
    out property <brush> surface:           #191938;
    out property <brush> surface-raised:    #252754;

    // ---- text ----
    out property <brush> foreground:        #f1effa;
    out property <brush> foreground-muted:  #b8b3cd;
    out property <brush> on-accent:         #ffffff; // text color on accent

    // ---- accents ----
    out property <brush> accent:            #7c72e8;
    out property <brush> accent-hover:      #9289f5;
    out property <brush> accent-pressed:    #6258cc;
    out property <brush> accent-disabled:   #49446f;

    // ---- controls ----
    out property <brush> control-bg:        #252754;
    out property <brush> control-hover:     #252865; // the hover shoulnt be too different
    out property <brush> control-pressed:   #3b3f7d;
    out property <brush> control-disabled:  #1a192a;

    // ---- lines ----
    out property <brush> border:            #3c3e5a;
    out property <brush> border-focus:      #7c72e8;
    out property <brush> border-disabled:   #242537;

    // ---- feedback ----
    out property <brush> danger:            #ff6b6b;
    out property <brush> success:           #55d6a5;

    // ---- shapes & metrics ----
    out property <length> radius-small:     2px;
    out property <length> radius-medium:    4px;
    out property <length> spacing-small:    4px;
    out property <length> spacing-medium:   8px;
    out property <length> spacing-large:    12px;
    out property <length> control-height:   32px;
    
    out property <length> border-width:     1px;
    out property <length> focus-ring-width: 2px;

    // ---- typography ----
    out property <length> font-size-small:   12px;
    out property <length> font-size-medium:  14px;
    out property <length> font-size-large:   16px;
    out property <int> font-weight-normal:   400;
    out property <int> font-weight-medium:   550;
    out property <int> font-weight-bold:     700;

    // ---- motion ----
    out property <duration> anim-very-fast: 60ms;
    out property <duration> anim-fast:      120ms;
    out property <duration> anim-medium:    200ms;

    // ---- task block ----
    in-out property <length> hour-height:           50px;
    in-out property <length> task-block-min-height: 40px;
    
    in-out property <length> window-width: 1280px;
    out property <length> time-axis-width: 48px;
    out property <length> task-block-width: max(60px,
        (window-width - time-axis-width - 3 * spacing-medium - 14 * border-width) / 9);
    out property <length> panel-width: task-block-width * 2 + spacing-medium * 3;

    // ---- misc ----
    out property <int> resize-step:     15;
    out property <length> column-width: task-block-width + 2 * border-width;
    out property <length> scroll-edge:  50px;
    out property <length> scroll-speed: 12px;
}

export component Border inherits Rectangle {
    width: Theme.border-width * 2;
    height: 100%;
    background: Theme.border;
}

export component HorizontalBorder inherits Rectangle {
    width: 100%;
    height: Theme.border-width * 2;
    background: Theme.border;
}
