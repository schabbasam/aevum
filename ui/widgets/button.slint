// widgets/button.slint
import { Theme } from "../theme.slint";

export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> primary: false;      // filled vs. outline
    callback clicked();

    height: Theme.control-height;
    min-width: 80px;
    border-radius: Theme.radius-small;
    border-width: primary ? 0px : Theme.border-width;
    border-color: !enabled ? Theme.border-disabled
               : has-hover ? Theme.border-focus
               : Theme.border;

    background: !enabled
        ? (primary ? Theme.accent-disabled : Theme.control-disabled)
        : primary
            ? (ta.pressed ? Theme.accent-pressed
              : ta.has-hover ? Theme.accent-hover
              : Theme.accent)
            : (ta.pressed ? Theme.control-pressed
              : ta.has-hover ? Theme.control-hover
              : Theme.control-bg);

    animate background { duration: Theme.anim-fast; }
    animate border-color { duration: Theme.anim-fast; }

    // focus ring
    Rectangle {
        visible: has-hover && root.enabled;
        border-radius: root.border-radius + Theme.focus-ring-width;
        border-width: Theme.focus-ring-width;
        border-color: Theme.border-focus;
        background: transparent;
        x: - Theme.focus-ring-width; 
        y: - Theme.focus-ring-width;
        width: parent.width + 2 * Theme.focus-ring-width;
        height: parent.height + 2 * Theme.focus-ring-width;
    }

    Text {
        text: root.text;
        color: root.primary ? Theme.on-accent : Theme.foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: Theme.font-size-medium;
        font-weight: Theme.font-weight-bold;
    }

    // expose focus to parent
    out property <bool> has-hover: ta.has-hover;

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { if (root.enabled) { root.clicked(); } }
    }

    // keyboard support
    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                if (root.enabled) { root.clicked(); }
                return accept;
            }
            return reject;
        }
    }
}
