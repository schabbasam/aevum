
import { Theme } from "../theme.slint";

export component Slider inherits Rectangle {
    
    // settings
    in property <bool> enabled: true;
    in property <brush> track-color: Theme.control-bg;

    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> value: 50;
    in property <float> step: 1;

    // other properties and callbacks
    out property <bool> pressed: ta.pressed;
    out property <bool> has-hover: ta.has-hover && root.enabled;
    callback edited(float);

    property <length> handle-size: 12px;
    
    // this is the horizontal distaance the handle's center can move
    // basically, the handle center moves between handle-size/2 and width - handle-size/2
    property <length> travel: max(1px, root.width - root.handle-size);

    // the percentage of the value, minimum is 0.0, maximum is 1.0
    // the max() is a guard to prevent it from dividing by 0
    // if for some reason the value is beyond the minimum or maximum, the clamp fixes it
    property <float> fraction: clamp(
        (root.value - root.minimum) / max(0.0001, root.maximum - root.minimum), 0, 1);
    
    // input is the x value of the mouse cursor
    function set-from-x(x: length) {
        if !root.enabled { return; }
        
        // undo the half handle offset and normalize from px to 0..1
        // stays in range, just like fraction
        let t = clamp((x - root.handle-size / 2) / root.travel, 0, 1);
        
        // actual raw value rounded to step to create the snap
        let v = round(
            (root.minimum + t * (root.maximum - root.minimum)) / root.step
        ) * root.step;

        // only fire the callback if the value changed
        if v != root.value { root.edited(v) }
    }

    // track
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 6px;
        
        background: root.has-hover ? Theme.control-hover : Theme.control-bg;
        animate background { duration: Theme.anim-fast; easing: ease-in-out; }
    }

    // handle
    Rectangle {
        // snapped to whole pixels
        x: round(root.fraction * root.travel / 1px) * 1px;
        y: (parent.height - self.height) / 2;

        width: root.handle-size;
        height: root.handle-size;

        background: root.has-hover ? Theme.accent-hover : Theme.accent;
        animate background { duration: Theme.anim-fast; easing: ease-in-out; }
    }

    ta := TouchArea {
        enabled: root.enabled;
        
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.set-from-x(self.mouse-x);
            }
        }
        moved => {
            if self.pressed {
                root.set-from-x(self.mouse-x);
            }
        }
    }
    
}
