import { Theme } from "../theme.slint";

export component ScrollBar inherits Rectangle {
    in property <length> content-height;
    in property <length> view-height;
    in-out property <length> offset; // content-y, never below zero

    property <length> max-scroll: max(0px, root.content-height - root.view-height);
    property <length> thumb-height: max(24px,
        root.height * root.view-height / max(1px, root.content-height));

    width: Theme.scrollbar-width;
    background: Theme.background;
    visible: root.max-scroll > 0px;

    Rectangle {
        x: 1px;
        width: parent.width - 2px;
        height: root.thumb-height;
        y: root.max-scroll > 0px
            ? (root.height - self.height) * (- root.offset / root.max-scroll)
            : 0px;
        background: (ta.pressed || ta.has-hover)
            ? Theme.accent-hover
            : Theme.foreground-muted;
    }

    ta := TouchArea {
        property <length> start-offset: 0px;

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                self.start-offset = root.offset;
            }
        }

        moved => {
            if self.pressed {
                root.offset = clamp(
                    self.start-offset
                        - (self.mouse-y - self.pressed-y)
                        * root.max-scroll
                        / max(1px, root.height - root.thumb-height),
                    - root.max-scroll,
                    0px
                );
            }
        }
    }
}
