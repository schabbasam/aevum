
export struct TaskForm {
    id:             int,
    title:          string,

    column:         int, // weekday 0..6
    start-minute:   int, // minutes since 00:00
    min-start:      int,
    max-end:        int,
    
    week-day-index: int,
    start-minute:   int,

    description:    string,
    duration:       int,
    recurrence:     string,
    category:       string,
    color:          string,
    color-brush:    color,
    completed:      bool,
    drag-preview:   image,
}


export global Api {
    pure callback int-to-transfer(int) -> data-transfer;
    pure callback transfer-to-int(data-transfer) -> int;
}
