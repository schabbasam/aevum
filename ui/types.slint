
export struct TaskForm {
    id:             int,
    title:          string,

    day:            int,
    month:          int,
    year:           int,

    column:         int, // weekday 0..6
    start-minute:   int, // minutes since 00:00
    min-start:      int,
    max-end:        int,
    
//    week-day-index: int,

    description:    string,
    duration:       int,
    recurrence:     string,
    category:       string,
    color:          string,
    color-brush:    color,
    completed:      bool,
    drag-preview:   image,
}

export global DragState {
    in-out property <int> id: 0;
    in-out property <int> duration: 60;
    in-out property <DragColors> color;
    in-out property <length> grab-y: 0px;
}

export struct DragColors {
    preview: color,
    border: color,
}

export global Api {
    pure callback int-to-transfer(int) -> data-transfer;
    pure callback transfer-to-int(data-transfer) -> int;
    
    // id, column, wished start minute -> real start minute or -1 if busy
    callback preview-start(int, int, int) -> int;

    // col, content-y, current index, extra height currently inserted
    // -> insertion index in the full list
    callback panel-slot-index(int, length, int, length) -> int;

    callback calculate-drag-colors(color) -> DragColors;
}
