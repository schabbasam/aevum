
export struct TaskForm {
    id:             int,
    title:          string,

    day:            int,
    month:          int,
    year:           int,
    
    week-day-index: int,
    start-minute:   int,

    description:    string,
    duration:       int,
    recurrence:     string,
    category:       string,
    color:          string,
    color-brush:    color,
    completed:      bool,
    drag-preview:   image,
    drop-x:         length,
    drop-y:         length,
}


export global Api {
    pure callback int-to-transfer(int) -> data-transfer;
    pure callback transfer-to-int(data-transfer) -> int;
}
