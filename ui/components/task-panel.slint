import { Theme } from "../theme.slint";
import { TaskBlock } from "task-block.slint";
import { TaskForm, Api, DragState } from "../types.slint";
import { ScrollBar } from "../widgets/scroll-bar.slint";

component Placeholder inherits Rectangle {
    in property <bool> shown;
    width: Theme.task-block-width;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: Theme.anim-medium; }
    background: DragState.colors.preview;

    border-width: Theme.focus-ring-width;
    border-color: DragState.colors.border;
    border-radius: Theme.radius-small;
}

component PanelColumn inherits VerticalLayout {
    in property <[TaskForm]> tasks;
    in property <int> slot: -1;
    in property <bool> dragging;
    in property <length> box-height;
    in property <length> extra;
    
    // spacing lives inside sells so collapsed cells leave no gap
    spacing: 0px;
    alignment: start;

    for task[i] in root.tasks : Rectangle {
        property <bool> hidden: root.dragging && task.id == DragState.id;
        property <length> gap: root.slot == i ? root.extra : 0px;

        clip: true;
        height: (self.hidden ? 0px : tb.height + Theme.spacing-medium) + self.gap;
        animate height { duration: Theme.anim-medium; easing: ease-out; }

        Placeholder {
            y: 0px;
            height: root.box-height;
            shown: parent.gap > 0px;
        }
        tb := TaskBlock {
            form: task;
            y: parent.height - self.height - Theme.spacing-medium;
        }
    }
    
    // the gap at the very end of the column
    Rectangle {
        clip: true;
        height: root.slot == root.tasks.length ? root.extra : 0px;
        animate height { duration: Theme.anim-medium; easing: ease-out; }
        
        Placeholder {
            y: 0px;
            height: root.box-height;
            shown: parent.height > 0px;
        }
    }
}

export component TaskPanel inherits Rectangle {
    in-out property <[TaskForm]> left-column;
    in-out property <[TaskForm]> right-column;
    
    callback dropped-here(int, int, int); // id, column 0 or 1, insertion index

    background: Theme.surface;
    vertical-stretch: 1;

    property <int> slot-col: 0;
    property <int> slot-index: -1;
    property <length> box-height: max(
        Theme.task-block-min-height,
        DragState.duration * Theme.hour-height / 60
    );
    property <length> extra: root.box-height + Theme.spacing-medium;

    fl := Flickable {
        height: 100%;
        interactive: false;

        HorizontalLayout {
            padding: Theme.spacing-medium;
            spacing: Theme.spacing-medium;
            
            PanelColumn {
                tasks: root.left-column;
                slot: drop.has-drag && root.slot-col == 0 ? root.slot-index : -1;
                dragging: drop.has-drag;
                box-height: root.box-height;
                extra: root.extra;
            }

            PanelColumn {
                tasks: root.right-column;
                slot: drop.has-drag && root.slot-col == 1 ? root.slot-index : -1;
                dragging: drop.has-drag;
                box-height: root.box-height;
                extra: root.extra;
            }
        }
    }

    drop := DropArea {
        can-drop(event) => {
            root.slot-col = event.position.x < self.width / 2 ? 0 : 1;
            root.slot-index = Api.panel-slot-index(
                root.slot-col,
                event.position.y - fl.content-y,
                root.slot-index,
                root.extra,
                DragState.id
            );
            return event.proposed-action;
        }
        dropped(event) => {
            root.dropped-here(
                Api.transfer-to-int(event.data),
                root.slot-col,
                max(0, root.slot-index)
            );
            return event.proposed-action;
        }
    }

    ScrollBar {
        x: parent.width - self.width;
        y: 0px;
        height: 100%;
        content-height: fl.content-height;
        view-height: fl.height;
        offset <=> fl.content-y;
    }
}
