import { Theme } from "../theme.slint";
import { TaskBlock } from "task-block.slint";

export component TaskPanel inherits Rectangle {
    background: Theme.surface;

    Flickable {
        width: 100%;
        height: 100%;

        HorizontalLayout {
            padding: Theme.spacing-medium;
            spacing: Theme.spacing-medium;

            VerticalLayout {
                spacing: Theme.spacing-medium;

                TaskBlock {
                    task-title: "first task";
                }
                TaskBlock {
                    task-title: "second task";
                    duration: 120;
                }
            }

            VerticalLayout {
                spacing: Theme.spacing-medium;

                TaskBlock {
                    task-title: "third task";
                    duration: 90;
                }
                TaskBlock {
                    task-title: "fourth task";
                    duration: 65;
                }
            }
        }
    }
}
