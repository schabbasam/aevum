import { Theme } from "../theme.slint";
import { TaskBlock } from "task-block.slint";
import { TaskForm, Api, DragState } from "../types.slint";
import { ScrollBar } from "../widgets/scroll-bar.slint";

export component TaskPanel inherits Rectangle {
    in-out property <[TaskForm]> left-column;
    in-out property <[TaskForm]> right-column;
    
    callback drag-offset-changed(length, length);
    callback dropped-here(int, int, length); // id, column 0 or 1, y coordinate

    background: Theme.surface;

    vertical-stretch: 1;

    fl := Flickable {
        height: 100%;
        interactive: false;

        HorizontalLayout {
            padding: Theme.spacing-medium;
            spacing: Theme.spacing-medium;

            VerticalLayout {
                spacing: Theme.spacing-medium;
                for task in root.left-column : TaskBlock {
                    form: task;
                    drag-offset-changed(ox, oy) => {
                        root.drag-offset-changed(ox, oy);
                    }
                }
            }

            VerticalLayout {
                spacing: Theme.spacing-medium;
                for task in root.right-column: TaskBlock {
                    form: task;
                    drag-offset-changed(ox, oy) => {
                        root.drag-offset-changed(ox, oy);
                    }
                }
            }
        }
    }

    drop := DropArea {
        can-drop(event) => {
            root.slot-col = event.position.x < self.width / 2 ? 0 : 1;
            root.slot-index = Api.panel-slot-index(
                root.slot-col,
                event.position.y - fl.content-y,
                root.slot-index,
                root.extra
            );
            return event.proposed-action;
        }
        dropped(event) => {
            root.dropped-here(
                Api.transfer-to-int(event.data),
                event.position.x < self.width / 2 ? 0 : 1,
                event.position.y - fl.content-y
            );
            return event.proposed-action;
        }
    }

    property <int> slot-col: 0;
    property <int> slot-index: -1;
    property <length> box-h: max(Theme.task-block-min-height,
                                DragState.duration * Theme.hour-height / 60);
    property <length> extra: root.box-h + Theme.spacing-medium;

    Rectangle {
        visible: drop.has-drag;
        background: DragState.color.with-alpha(0.35);

        x : Theme.spacing-medium + root.slot-col
            * (Theme.task-block-width + Theme.spacing-medium);
        y: root.slot-y + fl.content-y;

        width: Theme.task-block-width;
        height: max(Theme.task-block-min-height,
                    DragState.duration * Theme.hour-height / 60);

        border-width: Theme.focus-ring-width;
        border-color: Theme.accent-hover;
        border-radius: Theme.radius-small;
    }

    ScrollBar {
        x: parent.width - self.width;
        y: 0px;
        height: 100%;
        content-height: fl.content-height;
        view-height: fl.height;
        offset <=> fl.content-y;
    }
}
