import { Theme } from "../theme.slint";
import { TaskBlock } from "task-block.slint";
import { TaskForm } from "../types.slint";

export component TaskPanel inherits Rectangle {
    in-out property <[TaskForm]> tasks;
    background: Theme.surface;

    Flickable {
        width: 100%;
        height: 100%;

        HorizontalLayout {
            padding: Theme.spacing-medium;
            spacing: Theme.spacing-medium;

            VerticalLayout {
                spacing: Theme.spacing-medium;
                
                for task in tasks : TaskBlock {
                    form: task;
                }
            }

            VerticalLayout {
                spacing: Theme.spacing-medium;

            }
        }
    }
}
