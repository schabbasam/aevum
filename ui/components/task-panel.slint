import { Theme } from "../style.slint";

export component TaskBlock inherits Rectangle {
    in property <string> task-title: "Task";
    in property <int> duration: 60;

    width: Theme.task-block-width;
    height: max(
        Theme.task-block-min-height,
        duration * Theme.hour-height / 60
    );

    background: Theme.surface-hover;
    border-radius: 6px;

    Text {
        text: parent.task-title;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component TaskPanel inherits Rectangle {
    background: Theme.surface;

    Flickable {
        width: 100%;
        height: 100%;

        HorizontalLayout {
            padding: Theme.task-panel-padding;
            spacing: Theme.task-grid-spacing;

            VerticalLayout {
                spacing: Theme.task-grid-spacing;

                TaskBlock {
                    task-title: "first task";
                }
                TaskBlock {
                    task-title: "second task";
                    duration: 120;
                }
            }

            VerticalLayout {
                spacing: Theme.task-grid-spacing;

                TaskBlock {
                    task-title: "third task";
                    duration: 90;
                }
                TaskBlock {
                    task-title: "fourth task";
                    duration: 65;
                }
            }
        }
    }
}
