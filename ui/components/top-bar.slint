
import { Theme, HorizontalBorder } from "../theme.slint";
import { Button } from "../widgets/button.slint";
import { LineEdit } from "../widgets/line-edit.slint";
import { Slider } from "../widgets/slider.slint";

export component TopBar inherits Rectangle {
    in property <string> date-text;
    in property <string> time-text;
    in property <string> week-text;

    in-out property <string> category-name;
    in-out property <string> category-color;

    callback add-category(string, string); // name, color hex
    callback open-settings();

    height: Theme.control-height + 2 * Theme.spacing-medium + 2 * Theme.border-width;
    background: Theme.surface;

    Text {
        text: "Schraubim";
        color: Theme.foreground;
        font-size: Theme.font-size-medium;
        font-weight: Theme.font-weight-bold;

        horizontal-alignment: center;
        vertical-alignment: center;
    }
    
    VerticalLayout {
        HorizontalLayout {
            padding: Theme.spacing-medium;
            spacing: Theme.spacing-medium;

            Button {
                width: 140px;
                text: "New category";
                clicked => {
                    root.category-name = "";
                    root.category-color = "";
                    category-popup.show();
                }
            }

            Button {
                width: 100px;
                text: "Settings";
                clicked => {
                    root.open-settings();
                }
            }

            Text {
                text: "Zoom";
                color: Theme.foreground-muted;
                vertical-alignment: center;
            }

            Slider {
                width: 140px;
                minimum: 30;
                maximum: 120;
                value: Theme.hour-height / 1px;
                edited(v) => {
                    Theme.hour-height = v * 1px;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            Text {
                text: root.week-text
                    + " | " + root.date-text
                    + " | " + root.time-text;
                color: Theme.foreground;
                font-size: Theme.font-size-medium;
                vertical-alignment: center;
            }
        }
        HorizontalBorder {}
    }

    category-popup := PopupWindow {
        x: Theme.spacing-medium;
        y: root.height;
        width: 240px;
        height: self.preferred-width;
        
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            background: Theme.surface-raised;
            border-width: Theme.border-width;
            border-color: Theme.border;
            border-radius: Theme.radius-medium;
        }

        VerticalLayout {
            padding: Theme.spacing-medium;
            spacing: Theme.spacing-medium;
            
            cat-name := LineEdit {
                text <=> root.category-name;
                placeholder-text: "Category Name";
                max-length: 20;
            }

            cat-color := LineEdit {
                text <=> root.category-color;
                placeholder-text: "#RRGGBB";
                max-length: 7;
            }

            HorizontalLayout {
                spacing: Theme.spacing-medium;

                Button {
                    text: "Cancel";
                    clicked => {
                        category-popup.close();
                    }
                }

                Button {
                    text: "Add";
                    primary: true;
                    clicked => {
                        root.add-category(cat-name.text, cat-color.text);
                        category-popup.close();
                    }
                }
            }
        }
    }
}

