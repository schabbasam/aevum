import { Theme } from "../theme.slint";
import { TaskDraft } from "../types.slint";

import { CheckBox } from "../widgets/checkbox.slint";
import { Button } from "../widgets/button.slint";
import { SpinBox } from "../widgets/spin-box.slint";
import { LineEdit } from "../widgets/line-edit.slint";

export component TaskAttributes inherits Rectangle {

    // ---- input values ----
    in-out property <string> title-input: "";
    in-out property <string> description-input: "";
    in-out property <int> duration-input: 0;
    in-out property <string> recurrence-input: "";
    in-out property <string> category-input: "";
    in-out property <string> color-input: "";
    in-out property <bool> completed-input: false;

    // ---- max length ----
    in property <int> max-title: 0;
    in property <int> max-description: 0;
    in property <int> max-duration: 0;

    // ---- callbacks ----
    callback save-task(TaskDraft);
    callback input-changed();

    // ---- modes and states ----
    in property <bool> edit-mode: false;
    in property <bool> has-changes: false;
    in-out property <bool> collapsed: false;

    // the button enables when title isn't empty
    in property <bool> button-enabled: !title-input.is-empty;

    in property <string> status-message: "";
    in property <bool> is-error: false; 
    
    height: self.preferred-height;

    // ---- general appearance ----
    background: Theme.surface;

    changed title-input         => { root.input-changed(); }
    changed description-input   => { root.input-changed(); }
    changed duration-input      => { root.input-changed(); }
    changed recurrence-input    => { root.input-changed(); }
    changed category-input      => { root.input-changed(); }
    changed color-input         => { root.input-changed(); }
    changed completed-input     => { root.input-changed(); }
    
    // main layout that contains everything
    VerticalLayout {

        // heading and little indicator
        Rectangle {
            height: Theme.control-height;
            HorizontalLayout {
                padding-left: Theme.spacing-large * 1.1;
                padding-right: Theme.spacing-large * 1.1;

                Text {
                    horizontal-stretch: 1;
                    text: root.edit-mode ? "Edit Task" : "Add Task";
                    color: Theme.foreground;
                    font-size: Theme.font-size-large;
                    font-weight: Theme.font-weight-bold;
                    vertical-alignment: center;
                }
                
                Image {
                    source: @image-url("../assets/icons/chevron-down.svg");
                    colorize: Theme.foreground-muted;

                    transform-rotation: root.collapsed ? 180deg : 0deg;
                    animate transform-rotation { duration: Theme.anim-medium; easing: ease-in-out; }

                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                clicked => {
                    root.collapsed = !root.collapsed;
                }
            }
        }
        
        // ---- the collapsable part ----
        // wrapped in a rect so invisible ui elements dont eat the input
        Rectangle {
            clip: true;
            visible: self.body-height > 0px;
            height: self.body-height;


            property <length> body-height: root.collapsed ? 0px : body.preferred-height;
            animate body-height { duration: Theme.anim-medium; easing: ease-out-quart; }
            
            body := VerticalLayout {
                y: 0px;
                width: 100%;
                height: self.preferred-height;
                
                spacing: Theme.spacing-medium;
                padding-left: Theme.spacing-large;
                padding-right: Theme.spacing-large;
                padding-top: Theme.spacing-small;

                // ---- inputs ----
                
                // 1. title
                LineEdit {
                    placeholder-text: "Title";
                    max-length: root.max-title;
                    text <=> root.title-input;
                }
                
                // 3. description
                LineEdit {
                    max-length: root.max-description;
                    placeholder-text: "Descripton (optional)";
                    text <=> root.description-input;
                }
                
                // 4. duration 
                HorizontalLayout {
                    height: Theme.control-height;

                    Text {
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        text: "Duration:";
                        color: Theme.foreground;
                    }

                    SpinBox {
                        step-size: 5;
                        maximum: root.max-duration;
                        value <=> root.duration-input;
                    }

                }

                // 5. color as hex
                LineEdit {
                    max-length: 7;
                    placeholder-text: "#RRGGBB";
                    text <=> root.color-input;
                }
            
                // 6. category

                // 7. recurrence
                
                // 8. completed
                Rectangle {
                    property <bool> hovered: false;

                    HorizontalLayout {
                        spacing: Theme.spacing-medium;
                        alignment: center;

                        check := CheckBox {
                            checked <=> root.completed-input;
                            use-touch-area: false;
                            has-hover: cta.has-hover;
                        }

                        Text {
                            text: "completed";
                            color: Theme.foreground;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }

                    cta := TouchArea {
                        clicked => {
                            check.toggle();
                        }
                    }
                }
                
                // ---- save/create button ----
                
                Button {
                    horizontal-stretch: 1;
                    text: root.edit-mode ? "Save Changes" : "Add Task";
                    enabled: root.button-enabled;
                    
                    clicked => {
                        root.save-task({
                            title:          root.title-input,
                            description:    root.description-input,
                            duration:       root.duration-input,
                            recurrence:     root.recurrence-input,
                            category:       root.category-input,
                            color:          root.color-input,
                            completed:      root.completed-input,
                        });
                    }
                }
            }
        }

        // ---- status message ----

        Text {
            visible: root.status-message != "";
            vertical-alignment: center;
            horizontal-alignment: center;
            text: root.status-message;
            
            color: root.is-error ? Theme.danger : Theme.success;
            font-size: Theme.font-size-medium;
            font-weight: Theme.font-weight-normal;
        }
    }
}
