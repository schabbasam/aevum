import { Theme } from "../style.slint";
import { TaskForm } from "../types.slint";
import {  LineEdit, CheckBox, DatePickerPopup} from "std-widgets.slint";
import { Button } from "../widgets/button.slint";
import { SpinBox } from "../widgets/spin-box.slint";

export component TaskAttributes inherits Rectangle {

    // ---- input values ----
    in-out property <string> title-input: "";
    in-out property <int> day-input: 0;
    in-out property <int> month-input: 0;
    in-out property <int> year-input: 0;
    in-out property <string> description-input: "";
    in-out property <int> duration-input: 0;
    in-out property <string> recurrence-input: "";
    in-out property <string> category-input: "";
    in-out property <string> color-input: "";
    in-out property <bool> completed-input: false;

    // ---- callbacks ----
    callback save-task(TaskForm);

    // ---- modes and states ----
    in property <bool> edit-mode: false;
    in property <bool> has-changes: false;

    // the button enables when title isn't empty
    in property <bool> button-enabled: title-input > 0;

    in property <string> status-message: "";
    in property <bool> is-error: false;


    // ---- general appearance ----
    background: Theme.surface;

    VerticalLayout {
        padding: Theme.task-attributes-padding;
        spacing: Theme.task-attributes-spacing;

        // heading changes depending on the currend mode
        Text {
            text: root.edit-mode ? "Edit Task" : "Create Task";
            color: Theme.text;
            font-size: 16px;
            font-weight: 600;
        }

        // ---- required inputs ----
        
        // 1. title
        LineEdit {
            horizontal-stretch: 1;
            height: Theme.input-height;
            placeholder-text: "Title";
            text <=> root.title-input;
        }
        
        // 2. date with date picker popup and button
        datepicker := DatePickerPopup {
            close-policy: PopupClosePolicy.no-auto-close;
            accepted(date) => {
                root.day-input = date.day;
                root.month-input = date.month;
                root.year-input = date.year;
            }
            canceled => {
                datepicker.close()
            }
        }

        Button {
            horizontal-stretch: 1;
            height: Theme.input-height;
            text: "Date: " + root.day-input + "." + root.month-input + "." + root.year-input;
            clicked => {
                datepicker.show();
            }
        }
        
        // ---- optional stuff ----
        
        // 3. description
        LineEdit {
            horizontal-stretch: 1;
            height: Theme.input-height;
            placeholder-text: "Descripton (optional)";
            text <=> root.description-input;
        }
        
        // 4. duration 
        HorizontalLayout {
            height: Theme.input-height;

            Text {
                horizontal-stretch: 1;
                text: "Duration:";
                color: Theme.text;
            }

            SpinBox {
                step-size: 5;
                value <=> root.duration-input;
            }

        }

        // 5. color as hex
        LineEdit {
            horizontal-stretch: 1;
            height: Theme.input-height;
            placeholder-text: "#RRGGBB";
            text <=> root.color-input;
        }
    
        // 6. category

        // 7. recurrence
        
        // 8. completed
        HorizontalLayout {
            spacing: Theme.task-attributes-spacing;
            alignment: center;

            CheckBox {
                checked <=> root.completed-input;
            }

            Text {
                text: "Completed";
                color: Theme.text;
                vertical-alignment: center;
            }
        }

        // just to test things
        CheckBox {
    
        }


        // ---- status message ----

        Text {
            text: root.status-message;
            visible: root.status-message != "";
            color: root.is-error ? Theme.error-color : Theme.success-color;
            font-size: 11px;
        }

        
        // ---- save/create button ----
        
        Button {
            horizontal-stretch: 1;
            text: root.edit-mode ? "Save Changes" : "Add Task";
            enabled: root.button-enabled;
            
            clicked => {
                root.save-task({
                    title:          root.title-input,
                    day:            root.day-input,
                    month:          root.month-input,
                    year:           root.year-input,
                    description:    root.description-input,
                    duration:       root.duration-input,
                    recurrence:     root.recurrence-input,
                    category:       root.category-input,
                    color:          root.color-input,
                    completed:      root.completed-input
                });
            }
        }
    }
}
