import { Theme } from "../theme.slint";
import { TaskForm } from "../types.slint";

export global Api {
    pure callback text-to-transfer(string) -> data-transfer;
    pure callback transfer-to-text(data-transfer) -> string;
}

export component TaskBlock inherits Rectangle {
    in property <TaskForm> form;

    property <bool> dragging;

    width: Theme.task-block-width;
    height: max(
        Theme.task-block-min-height,
        form.duration * Theme.hour-height / 60
    );

    background: Theme.surface-raised;
    border-radius: Theme.radius-small;

    Text {
        text: form.title;
        color: Theme.foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    DragArea {
        data: Api.text-to-transfer("hello im being dragged");
        allow-move: true;
    }

}
