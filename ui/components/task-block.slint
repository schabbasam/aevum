import { Theme } from "../theme.slint";
import { TaskForm, Api } from "../types.slint";

export component TaskBlock inherits Rectangle {
    in-out property <TaskForm> form;
    
    out property <int> task-id: form.id;


    width: Theme.task-block-width;
    height: max(
        Theme.task-block-min-height,
        form.duration * Theme.hour-height / 60
    );

    background: form.color-brush;
    border-radius: Theme.radius-small;

    property <color> text-color:
        self.background.to-oklch().lightness > 0.6
        ? Theme.background
        : Theme.foreground;
    
    Text {
        text: form.title;
        color: root.text-color;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
   

    da := DragArea {

        data: Api.int-to-transfer(root.task-id);
        allow-move: true;

        drag-image: root.form.drag-preview;
        drag-image-offset-x: root.form.drag-offset-x / 1phx; 
        drag-image-offset-y: root.form.drag-offset-y / 1phx;
        
        ta := TouchArea {
            
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    root.form.drag-offset-x = self.pressed-x;
                    root.form.drag-offset-y = self.pressed-y;
                }
            }

        }
    }

}
