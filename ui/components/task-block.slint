import { Theme } from "../theme.slint";
import { TaskForm } from "../types.slint";

export global Api {
    pure callback text-to-transfer(string) -> data-transfer;
    pure callback transfer-to-text(data-transfer) -> string;
}

export component TaskBlock inherits Rectangle {
    in property <TaskForm> form;
    
    out property <int> task-id: form.id;


    width: Theme.task-block-width;
    height: max(
        Theme.task-block-min-height,
        form.duration * Theme.hour-height / 60
    );

    background: Theme.surface-raised;
    border-radius: Theme.radius-small;
    
    Text {
        text: form.title;
        color: Theme.foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    
    ta := TouchArea {
        property <length> drag-start-x;
        property <length> drag-start-y;
        
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                self.drag-start-x = self.pressed-x;
                self.drag-start-y = self.pressed-y;
                debug(drag-start-x, drag-start-y)
            }
        }

        da := DragArea {
            data: Api.text-to-transfer("hello im being dragged");
            allow-move: true;

            drag-image: root.form.drag-preview;
            drag-image-offset-x: root.width / 2phx;
            drag-image-offset-y: root.height / 2phx;
        }
    }

}
