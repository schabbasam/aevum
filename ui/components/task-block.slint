import { Theme } from "../theme.slint";
import { TaskForm, Api } from "../types.slint";

export component TaskBlock inherits Rectangle {
    in-out property <TaskForm> form;
    out property <int> task-id: form.id;

    in property <bool> calendar-mode: false;
    in property <length> scroll-y: 0px;

    callback drag-offset-changed(length, length);
    callback resize-pointer(bool, length);
    callback resize-finished(int, int, int); // id, start-minute, duration

    property <length> drag-offset-x: 0px;
    property <length> drag-offset-y: 0px;

    // ---- resize things ----
    property <bool> resizing: false;
    property <bool> resize-from-top: false;
    property <int> start0: 0;
    property <int> end0: 0;
    property <length> press-content-y: 0px;
    property <length> pointer-frame-y: 0px;

    property <length> handle-h: root.calendar-mode
        ? min(8px, root.height / 3) // never more than a third
        : 0px;

    property <length> pointer-content-y: root.pointer-frame-y - root.scroll-y;
    property <int> delta-minutes: round(
        (root.pointer-content-y - root.press-content-y)
        / Theme.hour-height * 60 / Theme.resize-step
    ) * Theme.resize-step;

    out property <int> live-start:
        !root.resizing ? root.form.start-minute
        : root.resize-from-top
            ? clamp( // clamp takes value, min, max and gives min/max if value is out of range
                root.start0 + root.delta-minutes, 
                root.form.min-start, 
                root.end0 - Theme.resize-step
            )
            : root.start0;

    out property <int> live-duration:
        !root.resizing ? root.form.duration
        : root.resize-from-top
            ? root.end0 - root.live-start
            : clamp(
                root.end0 + root.delta-minutes,
                root.start0 + Theme.resize-step,
                root.form.max-end
            ) - root.start0;

    property <length> exact-height: root.live-duration * Theme.hour-height / 60;

    width: Theme.task-block-width;
    height: root.calendar-mode
        ? root.exact-height
        : max(Theme.task-block-min-height, root.exact-height);

    background: form.color-brush;
    border-radius: Theme.radius-small;

    property <color> text-color: self.background.to-oklch().lightness > 0.6
        ? Theme.background : Theme.foreground;

    function begin-resize(from-top: bool, pointer-y: length) {
        root.resizing = true;
        root.resize-from-top = from-top;
        root.start0 = root.form.start-minute;
        root.end0 = root.form.start-minute + root.form.duration;
        root.press-content-y = pointer-y;
        root.pointer-frame-y = pointer-y + root.scroll-y;
        root.resize-pointer(true, root.pointer-frame-y);
    }

    function track-resize(pointer-y: length) {
        if root.resizing {
            root.pointer-frame-y = pointer-y + root.scroll-y;
            root.resize-pointer(true, root.pointer-frame-y);
        }
    }

    function end-resize() {
        root.resizing = false;
        root.resize-pointer(false, 0px);
    }

    function finish-resize() {
        if root.resizing {
            root.resize-finished(root.task-id, root.live-start, root.live-duration);
        }
        root.end-resize();
    }

    // bars that show the resizable edge on hover / while resizing
    Rectangle {
        visible: root.calendar-mode
            && (resize-ta-top.has-hover || (root.resizing && root.resize-from-top));
        y: 0px;
        width: 100%;
        height: Theme.focus-ring-width;
        background: Theme.accent-hover;
    }
    Rectangle {
        visible: root.calendar-mode
            && (resize-ta-bot.has-hover || (root.resizing && !root.resize-from-top));
        y: parent.height - self.height;
        width: 100%;
        height: Theme.focus-ring-width;
        background: Theme.accent-hover;
    }

    Text {
        text: form.title;
        color: root.text-color;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    da := DragArea {

        data: Api.int-to-transfer(root.task-id);
        allow-move: true;

        drag-image: root.form.drag-preview;
        drag-image-offset-x: root.drag-offset-x / 1phx; 
        drag-image-offset-y: root.drag-offset-y / 1phx;
        
        ta := TouchArea {
            mouse-cursor: root.resizing ?
                MouseCursor.ns-resize : MouseCursor.default;
            
            pointer-event(event) => {
                if event.kind == PointerEventKind.cancel {
                    root.end-resize();
                } else if event.kind == PointerEventKind.down {
                    if event.button == PointerEventButton.left {
                        root.drag-offset-x = self.pressed-x;
                        root.drag-offset-y = self.pressed-y;
                        root.drag-offset-changed(
                            root.drag-offset-x,
                            root.drag-offset-y,
                        );
                    } else if event.button == PointerEventButton.right && root.calendar-mode {
                        root.resizing = true;
                        root.resize-from-top = self.mouse-y < root.height / 2;
                        root.start0 = root.form.start-minute + root.form.duration;
                        root.press-content-y = root.y + self.mouse-y;
                        root.pointer-frame-y = root.y + self.mouse-y + root.scroll-y;
                        root.resize-pointer(true, root.pointer-frame-y);
                    }
                } else if event.kind == PointerEventKind.up 
                        && event.button == PointerEventButton.right
                        && root.resizing {
                    root.resize-finished(
                        root.task-id,
                        root.live-start,
                        root.live-duration
                    );
                    root.end-resize();
                }
            }

            moved => {
                if root.resizing {
                    root.pointer-frame-y = root.y + self.mouse-y + root.scroll-y;
                    root.resize-pointer(true, root.pointer-frame-y);
                }
            }
        }
    }

    // resize handles
    resize-ta-top := TouchArea {
        enabled: root.calendar-mode;
        x: 0px;
        y: 0px;
        width: 100%;
        height: root.handle-h;
        mouse-cursor: MouseCursor.ns-resize;

        pointer-event(event) => {
            if event.kind == PointerEventKind.down
                    && event.button == PointerEventButton.left {
                root.begin-resize(true, root.y + self.y + self.mouse-y);
            } else if event.kind == PointerEventKind.up
                    && event.button == PointerEventButton.left {
                root.finish-resize();
            } else if event.kind == PointerEventKind.cancel {
                root.end-resize();
            }
        }
        moved => {
            root.track-resize(root.y + self.y + self.mouse-y);
        }
    }

    resize-ta-bot := TouchArea {
        enabled: root.calendar-mode;
        x: 0px;
        y: parent.height - self.height;
        width: 100%;
        height: root.handle-h;
        mouse-cursor: MouseCursor.ns-resize;

        pointer-event(event) => {
            if event.kind == PointerEventKind.down
                    && event.button == PointerEventButton.left {
                root.begin-resize(false, root.y + self.y + self.mouse-y);
            } else if event.kind == PointerEventKind.up
                    && event.button == PointerEventButton.left {
                root.finish-resize();
            } else if event.kind == PointerEventKind.cancel {
                root.end-resize();
            }
        }
    }
}
