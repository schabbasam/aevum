import { Theme } from "../theme.slint";
import { TaskForm, Api } from "../types.slint";

export component TaskBlock inherits Rectangle {
    in-out property <TaskForm> form;
    out property <int> task-id: form.id;

    in property <bool> calendar-mode: false;
    in property <length> scroll-y: 0px;

    callback drag-offset-changed(length, length);
    callback resize-pointer(bool, length);
    callback resize-finished(int, int, int); // id, start-minute, duration

    property <length> drag-offset-x: 0px;
    property <length> drag-offset-y: 0px;

    // ---- resize things ----
    property <bool> resizing: false;
    property <bool> resize-from-top: false;
    property <int> start0: 0;
    property <int> end0: 0;
    property <length> press-content-y: 0px;
    property <length> pointer-frame-y: 0px;

    property <length> pointer-content-y: root.pointer-frame-y - root.scroll-y;
    property <int> delta-minutes: round(
        (root.pointer-content-y - root.press-content-y)
        / Theme.hour-height * 60 / Theme.resize-step
    ) * Theme.resize-step;

    out property <int> live-start:
        !root.resizing ? root.form.start-minute
        : root.resize-from-top
            ? clamp( // clamp takes value, min, max and gives min/max if value is out of range
                root.start0 + root.delta-minutes, 
                root.form.min-start, 
                root.end0 - Theme.resize-step
            )
            : root.start0;

    out property <int> live-duration:
        !root.resizing ? root.form.duration
        : root.resize-from-top
            ? root.end0 - root.live-start
            : clamp(
                root.end0 + root.delta-minutes,
                root.start0 + Theme.resize-step,
                root.form.max-end
            ) - root.start0;

    property <length> exact-height: root.live-duration * Theme.hour-height / 60;

    width: Theme.task-block-width;
    height: root.calendar-mode
        ? root.exact-height
        : max(Theme.task-block-min-height, root.exact-height);

    background: form.color-brush;
    border-radius: Theme.radius-small;

    property <color> text-color: self.background.to-oklch().lightness > 0.6
        ? Theme.background : Theme.foreground;

    function end-resize() {
        root.resizing = false;
        root.resize-pointer(false, 0px);
    }

    // ---- focus ring ----
    Rectangle {
        visible: root.resizing;
        x: -Theme.focus-ring-width;
        y: -Theme.focus-ring-width;
        width: parent.width + 2 * Theme.focus-ring-width;
        height: parent.height + 2 * Theme.focus-ring-width;
        border-radius: root.border-radius + Theme.focus-ring-width;
        border-width: Theme.focus-ring-width;
        border-color: Theme.border-focus;
        background: transparent;
    }

    // bar at the edge that is currently being resized
    Rectangle {
        visible: root.resizing;
        width: parent.width;
        height: Theme.focus-ring-width;
        y: root.resize-from-top
            ? 0px : parent.height - self.height;
        background: Theme.accent-hover;
    }


    // starting state
    property <length> resize-start-pointer-y: ;
    property <int> resize-start-duration: 0;
    property <int> resize-start-minute: form.duration;
    
    property <int> resize-preview-start-minute: form.start-minute;
    property <int> resize-preview-duration: form.duration;

    out property <int> displayed-start-minute:
        resizing ? resize-preview-start-minute : form.start-minute;

    // tast-id, new-start-minute and new-duration are the parameters
    callback resize-finished(int, int, int);

    width: Theme.task-block-width;
    height: max(
        Theme.task-block-min-height,
        // thats what im working on rn, still under construction
        root.resize-preview-duration * Theme.hour-height / 60
    );

    Text {
        text: form.title;
        color: root.text-color;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
   

    da := DragArea {

        data: Api.int-to-transfer(root.task-id);
        allow-move: true;

        drag-image: root.form.drag-preview;
        drag-image-offset-x: root.drag-offset-x / 1phx; 
        drag-image-offset-y: root.drag-offset-y / 1phx;
        
        ta := TouchArea {
            
            pointer-event(event) => {
                if event.kind == PointerEventKind.cancel {
                    root.resizing = false;
                } else if event.kind == PointerEventKind.down {
                    if event.button == PointerEventButton.right {
                        root.resizing = true;

                        // where did it get clicked?
                        root.resize-from-top = ta.pressed-y < root.height / 2;
                        
                        // save the original state
                        root.resize-start-pointer-y = ta.mouse-y;
                        root.resize-start-minute = root.form.start-minute;
                        root.resize-start-duration = root.form.duration;

                        // initialize preview
                        root.resize-preview-start-minute = root.form.start-minute;
                        root.resize-preview-duration = root.form.duration;
                    }
                    root.drag-offset-x = self.pressed-x;
                    root.drag-offset-y = self.pressed-y;
                    root.drag-offset-changed(
                        root.drag-offset-x,
                        root.drag-offset-y,
                    );
                } else if event.kind == PointerEventKind.up {
                    if event.button == PointerEventButton.right {
                        root.resize-finished(
                            root.task-id,
                            root.resize-preview-start-minute,
                            root.resize-preview-duration,
                        );
                        root.resizing = false;
                    }
                }
            }

            moved => {
                // the logic: delta time = delta y / hour height * 60
                if root.resizing {
                    let delta-minutes = round(
                        (
                            (ta.mouse-y - root.resize-start-pointer-y)
                            / Theme.hour-height * 60
                        ) / Theme.resize-step
                    ) * Theme.resize-step;

                    let original-end =
                        root.resize-start-minute
                        + root.resize-start-duration;

                    if root.resize-from-top {
                        // only the upper end changes
                        // the lower border stays the same
                        let new-start = max(
                            0,
                            min(
                                original-end - Theme.resize-step,
                                root.resize-start-minute + delta-minutes
                            )
                        );

                        root.resize-preview-start-minute = new-start;
                        root.resize-preview-duration = original-end - new-start;

                    } else {
                        // the exact opposite obviously
                        root.resize-preview-start-minute = root.resize-start-minute;
                        root.resize-preview-duration = max(
                            Theme.resize-step,
                            min(
                                1440 - root.resize-start-minute,
                                root.resize-start-duration + delta-minutes
                            )
                        );
                    }
                }
            }
        }
    }
}
