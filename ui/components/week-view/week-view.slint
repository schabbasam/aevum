import { Theme, Border, HorizontalBorder } from "../../theme.slint";
import { TaskBlock } from "../task-block.slint";
import { TaskForm, Api, DragState } from "../../types.slint";
import { ScrollBar } from "../../widgets/scroll-bar.slint";
import { TimeAxis } from "time-axis.slint";
import { DayHeader, DayColumn } from "day-components.slint";
import { WeekGrid } from "week-grid.slint";

export component WeekView inherits Rectangle {
    background: Theme.background;

    in-out property <[TaskForm]> scheduled-tasks;

    callback task-placed(int, int, int);    // id, column, start-minute
    callback task-resized(int, int, int);   // id, start-minute, duration

    property <bool> resize-active: false;
    property <length> resize-pointer-y: 0px;
    
    // looks crazy, but it is kinda simple
    // -1 means up, 0 means nothing, 1 means down
    property <int> scroll-dir:
        (top-zone.has-drag 
            || (root.resize-active
                && root.resize-pointer-y < Theme.scroll-edge)
        ) ? -1
        : (bottom-zone.has-drag
            || (root.resize-active
                && root.resize-pointer-y > scroll-area.height - Theme.scroll-edge)
        ) ? 1
        : 0;

    function place(id: int, col: int, y: length) {
        root.task-placed(
            id,
            clamp(col, 0, 6),
            round(
                (y - DragState.grab-y)
                / Theme.hour-height * 60
                / Theme.resize-step
            ) * Theme.resize-step
        );
    }

    Timer {
        interval: 16ms;
        running: root.scroll-dir != 0;
        triggered => {
            fl.content-y = clamp(
                fl.content-y - root.scroll-dir * Theme.scroll-speed,
                min(0px, fl.height - fl.content-height),
                0px
            );
        }
    }

    WeekGrid {}

    HorizontalLayout {
        Border {}
        TimeAxis {
            scroll-y: fl.content-y;
        }

        ScrollBar {
            width: 12px;
            content-height: fl.content-height;
            view-height: fl.height;
            offset <=> fl.content-y;
        }
    }
}

