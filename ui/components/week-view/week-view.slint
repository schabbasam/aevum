import { Theme, Border, HorizontalBorder } from "../../theme.slint";
import { TaskBlock } from "../task-block.slint";
import { TaskForm, Api, DragState } from "../../types.slint";
import { ScrollBar } from "../../widgets/scroll-bar.slint";
import { TimeAxis } from "time-axis.slint";
import { DayHeader, DayColumn } from "day-components.slint";
import { WeekGrid } from "week-grid.slint";

export component WeekView inherits Rectangle {
    background: Theme.background;

    in-out property <[TaskForm]> scheduled-tasks;

    callback task-placed(int, int, int);    // id, column, start-minute
    callback task-resized(int, int, int);   // id, start-minute, duration
    
    WeekGrid {}

    HorizontalLayout {
        Border {}
        TimeAxis {
            scroll-y: wg.content-y;
        }

        wg := WeekGrid {
            scheduled-tasks: root.scheduled-tasks;

            task-placed(id, col, start) => {
                root.task-placed(id, col, start);
            }
            task-resized(id, start, duration) => {
                root.task-resized(id, start, duration)
            }
        }

        ScrollBar {
            vertical-stretch: 1;
            content-height: wg.content-height;
            view-height: wg.height;
            offset <=> wg.content-y;
        }
    }
}

