
import { DayHeader, DayColumn } from "day-components.slint";
import { Theme, HorizontalBorder } from "../../theme.slint";
import { TaskBlock } from "../task-block.slint";
import { TaskForm, Api, DragState } from "../../types.slint";
import { ScrollBar } from "../../widgets/scroll-bar.slint";

export component WeekGrid inherits VerticalLayout {
    
    in property <[TaskForm]> scheduled-tasks;
    callback task-placed(int, int, int);
    callback task-resized(int, int, int);

    property <bool> resize-active: false;
    property <length> resize-pointer-y: 0px;

    in-out property <length> content-y;
    out property <length> content-height: fl.content-height;
    out property <length> view-height: fl.height;

    function place(id: int, col: int, y: length) {
        root.task-placed(
            id,
            clamp(col, 0, 6),
            round(
                (y - DragState.grab-y)
                / Theme.hour-height * 60
                / Theme.resize-step
            ) * Theme.resize-step
        );
    }
    
    // looks crazy, but it is kinda simple
    // -1 means up, 0 means nothing, 1 means down
    property <int> scroll-dir:
        (top-zone.has-drag 
            || (root.resize-active
                && root.resize-pointer-y < Theme.scroll-edge)
        ) ? -1
        : (bottom-zone.has-drag
            || (root.resize-active
                && root.resize-pointer-y > scroll-area.height - Theme.scroll-edge)
        ) ? 1
        : 0;

    HorizontalLayout {
        for i in 7: DayHeader {
            text: "Day " + i;
        }
    }
    HorizontalBorder {}
    
    HorizontalLayout {
        vertical-stretch: 1;

        scroll-area := Rectangle {
            clip: true;
    
            Timer {
                interval: 16ms;
                running: root.scroll-dir != 0;
                triggered => {
                    fl.content-y = clamp(
                        fl.content-y - root.scroll-dir * Theme.scroll-speed,
                        min(0px, fl.height - fl.content-height),
                        0px
                    );
                }
            }
            
            fl := Flickable {
                width: 100%;
                height: 100%;
                content-width: 7 * Theme.column-width;
                content-height: 24 * Theme.hour-height;
                interactive: false; // fl shouln't eat the input for drag/resize
                content-y <=> root.content-y;
                
                for i in 7: DayColumn {
                    index: i;
                    x: i * Theme.column-width;
                    y: 0px;

                    dropped(id, col, y) => {
                        root.place(id, col, y);
                    }
                }

                for task in root.scheduled-tasks : TaskBlock {
                    calendar-mode: true;
                    form: task;
                    scroll-y: fl.content-y;
                    x: task.column * Theme.column-width + 2 * Theme.border-width;
                    y: self.live-start * Theme.hour-height / 60;

                    resize-pointer(active, py) => {
                        root.resize-active = active;
                        root.resize-pointer-y = py;
                    }
                    resize-finished(id, start, dura) => {
                        root.task-resized(id, start, dura);
                    }
                }
            }
            
            // edge zones: autoscroll while dragging
            top-zone := DropArea {
                y: 0px;
                width: parent.width;
                height: Theme.scroll-edge;
                
                can-drop(event) => {
                    return event.proposed-action;
                }
                dropped(event) => {
                    root.place(
                        Api.transfer-to-int(event.data),
                        floor(event.position.x / Theme.column-width),
                        event.position.y - fl.content-y
                    );
                    return event.proposed-action;
                }
            }

            bottom-zone := DropArea {
                y: parent.height - Theme.scroll-edge;
                width: parent.width;
                height: Theme.scroll-edge;
                
                can-drop(event) => {
                    return event.proposed-action;
                }
                dropped(event) => {
                    root.place(
                        Api.transfer-to-int(event.data),
                        floor(event.position.x / Theme.column-width),
                        event.position.y + self.y - fl.content-y
                    );
                    return event.proposed-action;
                }
            }
        }
    }
}

