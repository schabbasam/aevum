
import { Theme } from "../../theme.slint";
import "../../assets/fonts/FreeMono.otf";

export component TimeAxis inherits Rectangle {
    in property <length> scroll-y;
    property <int> ticks: 6; // marks per hour, default every 15min

    width: Theme.time-axis-width;
    background: Theme.surface;
    clip: true;

    // little horizontal lines for the scale
    for n in 24 * root.ticks : Rectangle {
        property <bool> hour: mod(n, root.ticks) == 0;
        x: parent.width - self.width;
        y: n * (Theme.hour-height / root.ticks) + root.scroll-y + Theme.control-height;

        // make the marks for hours bigger
        width: self.hour ? 12px : 6px; 
        height: Theme.border-width;
        background: self.hour ? Theme.foreground-muted : Theme.border;
    }

    // the time text
    for h in 24 : Text {
        x: 0px;
        y: h * Theme.hour-height + root.scroll-y - self.height / 2 + Theme.control-height;

        width: parent.width - 16px; // left of the longest stick
        height: 16px;

        horizontal-alignment: right;
        vertical-alignment: center;
        color: Theme.foreground-muted;

        font-size: Theme.font-size-small;
        font-family: "Free Mono";
        text: (h < 10 ? "0" : "") + h + ":00";
    }
}
