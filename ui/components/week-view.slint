import { Theme, Border, HorizontalBorder } from "../theme.slint";
import { TaskBlock } from "task-block.slint";
import { TaskForm, Api } from "../types.slint";


export component DayHeader inherits HorizontalLayout {
    in property <string> text: "Someday";

    height: Theme.control-height;
    width: self.preferred-width;
    Border {}
    Rectangle {
        background: Theme.surface;
        width: Theme.task-block-width;
        Text {
            text: root.text;
            color: Theme.foreground;
            font-size: Theme.font-size-medium;
        }
    }
}

export component Idk inherits VerticalLayout {
    in property <string> text;

    height: self.preferred-height;
    width: Theme.task-block-width;

    Rectangle {
        background: Theme.background;
        height: Theme.hour-height;
        Text {
            text: root.text;
            font-size: Theme.font-size-small;
            color: Theme.accent-disabled;
        }
    }
    HorizontalBorder {background: Theme.surface-raised;}
}

export component DayColumn inherits HorizontalLayout {
    callback dropped(int, length, length);
    // in-out property <length> offset-x;
    in-out property <length> offset-y;

    width: Theme.task-block-width + border.width;
    border := Border {}
    da := DropArea {
        width: 100%;
        height: 100%;
        can-drop(event) => {
            return event.proposed-action;
        }

        dropped(event) => {
            root.dropped(
                Api.transfer-to-int(event.data),
                da.absolute-position.x,
                da.absolute-position.y + event.position.y - root.offset-y,

            );
            // this callback requires a return value of DragAction
            return event.proposed-action;
        }
    }
}

export component WeekView inherits Rectangle {
    background: Theme.background;

    callback dropped(int, length, length);

    in-out property <[TaskForm]> scheduled-tasks;

    in-out property <length> active-drag-offset-x: 0px;
    in-out property <length> active-drag-offset-y: 0px;

    for task in scheduled-tasks : TaskBlock {
        drag-offset-changed(ox, oy) => {
            root.active-drag-offset-x = ox;
            root.active-drag-offset-y = oy;
        }
        x: task.drop-x;
        y: task.drop-y;
        form: task;

    }

    VerticalLayout {
        HorizontalLayout {
            for i in 7: DayHeader {
                text: "Day " + i;
            }
        }
        HorizontalBorder {}
        Flickable {
            HorizontalLayout {
                for i in 7: DayColumn {
                    // x offset not needed anymore
                    // offset-x: root.active-drag-offset-x;
                    offset-y: root.active-drag-offset-y;
                    
                    dropped(id, x, y) => {
                        root.dropped(
                            id,
                            x - root.absolute-position.x, 
                            y - root.absolute-position.y,
                        );
                    }
                }
            }
        }
    }
}

