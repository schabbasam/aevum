import { Theme } from "../theme.slint";
import { Api } from "task-block.slint";

export component WeekView inherits Rectangle {
    background: Theme.background;

    in-out property <length> tb-x;
    in-out property <length> tb-y;

    TouchArea {
        property <length> grab-x;
        property <length> grab-y;
        mouse-cursor: grab;
        
        // im not sure wtf im doing, but i want to get the position of
        // the dragged task block and move it there
        pointer-event(event) => {
            if event.kind == PointerEventKind.down
                && event.button == PointerEventButton.left {
                
                grab-x = self.mouse-x;
                grab-y = self.mouse-y;
            } else if event.kind == PointerEventKind.move && self.pressed {
                root.tb-x = self.absolute-position.x + self.mouse-x;
                root.tb-y = self.absolute-position.y + self.mouse-y;
            } else if event.kind == PointerEventKind.up
                && event.button == PointerEventButton.left {
                root.tb-x = self.absolute-position.x + self.mouse-x;
                root.tb-y = self.absolute-position.y + self.mouse-y;
            }
        }
    }

}
