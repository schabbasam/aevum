import { Theme, Border, HorizontalBorder } from "../theme.slint";
import { TaskBlock } from "task-block.slint";
import { TaskForm, Api } from "../types.slint";
import { ScrollBar } from "../widgets/scroll-bar.slint";

export component DayHeader inherits HorizontalLayout {
    in property <string> text: "Someday";

    height: Theme.control-height;
    width: self.preferred-width;
    Border {}
    Rectangle {
        background: Theme.surface;
        width: Theme.task-block-width;
        Text {
            text: root.text;
            color: Theme.foreground;
            font-size: Theme.font-size-medium;
        }
    }
}

export component DayColumn inherits Rectangle {
    in property <int> index;
    callback dropped(int, int, length); // id, column, column-y
    
    width: Theme.column-width;
    height: 24 * Theme.hour-height;

    Border {}
    
    da := DropArea {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;

        can-drop(event) => {
            return event.proposed-action;
        }

        dropped(event) => {
            root.dropped(
                Api.transfer-to-int(event.data),
                root.index,
                event.position.y
            );
            return event.proposed-action;
        }
    }
}

export component WeekView inherits Rectangle {
    background: Theme.background;

    in-out property <[TaskForm]> scheduled-tasks;
    in-out property <length> active-drag-offset-x: 0px;
    in-out property <length> active-drag-offset-y: 0px;

    callback task-placed(int, int, int);    // id, column, start-minute
    callback task-resized(int, int, int);   // id, start-minute, duration

    property <bool> resize-active: false;
    property <length> resize-pointer-y: 0px;
    
    // looks crazy, but it is kinda simple
    // -1 means up, 0 means nothing, 1 means down
    property <int> scroll-dir:
        (top-zone.has-drag 
            || (root.resize-active
                && root.resize-pointer-y < Theme.scroll-edge)
        ) ? -1
        : (bottom-zone.has-drag
            || (root.resize-active
                && root.resize-pointer-y > scroll-area.height - Theme.scroll-edge)
        ) ? 1
        : 0;

    function place(id: int, col: int, y: length) {
        root.task-placed(
            id,
            clamp(col, 0, 6),
            round(
                (y - root.active-drag-offset-y)
                / Theme.hour-height * 60
                / Theme.resize-step
            ) * Theme.resize-step
        );
    }

    Timer {
        interval: 16ms;
        running: root.scroll-dir != 0;
        triggered => {
            fl.content-y = clamp(
                fl.content-y - root.scroll-dir * Theme.scroll-speed,
                min(0px, fl.height - fl.content-height),
                0px
            );
        }
    }


    VerticalLayout {
        HorizontalLayout {
            for i in 7: DayHeader {
                text: "Day " + i;
            }
        }
        HorizontalBorder {}

        scroll-area := Rectangle {
            clip: true;
            
            fl := Flickable {
                content-width: 7 * Theme.column-width;
                content-height: 24 * Theme.hour-height;
                interactive: false; // fl shouln't eat the input for drag/resize
                
                for i in 7: DayColumn {
                    index: i;
                    x: i * Theme.column-width;
                    y: 0px;

                    dropped(id, col, y) => {
                        root.place(id, col, y);
                    }
                }

                for task in root.scheduled-tasks : TaskBlock {
                    calendar-mode: true;
                    form: task;
                    scroll-y: fl.content-y;
                    x: task.column * Theme.column-width + 2 * Theme.border-width;
                    y: self.live-start * Theme.hour-height / 60;

                    drag-offset-changed(ox, oy) => {
                        root.active-drag-offset-x = ox;
                        root.active-drag-offset-y = oy;
                    }
                    resize-pointer(active, py) => {
                        root.resize-active = active;
                        root.resize-pointer-y = py;
                    }
                    resize-finished(id, start, dura) => {
                        root.task-resized(id, start, dura);
                    }
                }
            }
            
            // edge zones: autoscroll while dragging
            top-zone := DropArea {
                y: 0px;
                width: parent.width;
                height: Theme.scroll-edge;
                
                can-drop(event) => {
                    return event.proposed-action;
                }
                dropped(event) => {
                    root.place(
                        Api.transfer-to-int(event.data),
                        floor(event.position.x / Theme.column-width),
                        event.position.y - fl.content-y
                    );
                    return event.proposed-action;
                }
            }

            bottom-zone := DropArea {
                y: parent.height - Theme.scroll-edge;
                width: parent.width;
                height: Theme.scroll-edge;
                
                can-drop(event) => {
                    return event.proposed-action;
                }
                dropped(event) => {
                    root.place(
                        Api.transfer-to-int(event.data),
                        floor(event.position.x / Theme.column-width),
                        event.position.y + self.y - fl.content-y
                    );
                    return event.proposed-action;
                }
            }

            ScrollBar {
                x: parent.width - self.width;
                y: 0px;
                height: 100%;
                content-height: fl.content-height;
                view-height: fl.height;
                offset <=> fl.content-y;
            }

        }
    }
}

