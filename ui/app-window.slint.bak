
import {
    Button,
    CheckBox,
    LineEdit
} from "std-widgets.slint";

// my own component
export component Box inherits Rectangle {
    in property <color> text-color: black;
    in property <color> bg-color: white;
    in property <string> text: "default";
    // width, height, x and y are there by default
    
    background: bg-color;

    Text {
        font-size: 16px;
        color: parent.text-color;
        text: parent.text;
    }
}

// by default everything in a slint file is private
// export and import are used for public stuff
export component MainWindow inherits Window {
    
    title: "playing around with Slint";
    
    // roughly making the app layout
    VerticalLayout {
        Box {
            bg-color: red;
            text: "navigation bar";
            height: 50px;
        }
        HorizontalLayout {
            Box {
                bg-color: green;
                text: "task blocks";
                max-width: 260px;
                min-width: 140px;
                horizontal-stretch: 0.5;
            }
            GridLayout {
                spacing: 10px;
                padding: 10px;

                Row {
                    for i in 7 : Box {
                        height: 35px;
                        bg-color: cyan;
                        text: "day " + (i+1);
                        min-width: 70px;
                    }
                }
                Row {
                    for i in 7 : Box {
                        bg-color: blue;
                        text: "grid " + (i+1);
                    }
                }
            }
        }
    }

}
