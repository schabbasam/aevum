// cointains all colors, paddings etc.

export global Theme {
    in-out property <color> background:    #181a20;
    in-out property <color> surface:       #22252d;
    in-out property <color> surface-hover: #2c303a;

    in-out property <color> text: #e5e7eb;

    in-out property <length> panel-width:  240px;

    in-out property <length> task-panel-padding:    12px;
    in-out property <length> task-grid-spacing:     8px;
    in-out property <length> task-block-width:      100px;
    in-out property <length> task-block-min-height: 50px;

    in-out property <length> hour-height: 60px;
}
